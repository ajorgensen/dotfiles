[user]
  name = Andrew Jorgensen
  email = git@aj.codes

[github]
  user = ajorgensen

[init]
  defaultBranch = main
[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
  tool = nvimdiff

[difftool]
  prompt = false

[difftool "nvimdiff"]
  cmd = nvim -d "$LOCAL" "$REMOTE"

[push]
  default = simple
  autoSetupRemote = true
  followTags = true

[fetch]
  prune = true
  pruneTags = true
  all = true

[help]
  autocorrect = prompt

[commit]
  gpgsign = true
  verbose = true

[rerere]
  enabled = true
  autoupdate = true

[core]
    # Use custom `.gitignore`
  excludesfile = ~/.config/git/ignore

    # Treat spaces before tabs and all kinds of trailing whitespace as an error.
    # [default] trailing-space: looks for spaces at the end of a line
    # [default] space-before-tab: looks for spaces before tabs at the beginning of a line
  whitespace = space-before-tab,-indent-with-non-tab,trailing-space

    # Make `git rebase` safer on macOS.
    # More info: <http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/>
  trustctime = false

    # Prevent showing files whose names contain non-ASCII symbols as unversioned.
    # http://michael-kuehnel.de/git/2014/11/21/git-mac-osx-and-german-umlaute.html
  precomposeunicode = false

    # Speed up commands involving untracked files such as `git status`.
    # https://git-scm.com/docs/git-update-index#_untracked_cache
  untrackedCache = true

  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true  # use n and N to move between diff sections
  dark = true      # or light = true, or omit for auto-detection

[rebase]
  autoSquash = true
  autostash = true
  updateRefs = true

[merge]
  conflictstyle = zdiff3

[pull]
  rebase = true
  ff = only

[apply]
  # Detect whitespace errors when applying a patch.
  whitespace = fix

[color]
    # Use colors in Git commands that are capable of colored output when
    # outputting to the terminal. (This is the default setting in Git ≥ 1.8.4.)
  ui = auto

[color "diff"]
  whitespace = red reverse

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[log]
  date = iso

[alias]
  co = checkout
  ci = commit
  st = status
  br = branch

  to-the-chopper = commit --amend --no-edit

  changed = !"git log --oneline  $(git default-branch)..HEAD"
  hist = log --graph --abbrev-commit --decorate --date=short \
    --format=format:'%C(bold cyan)%h%C(reset) %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)%an%C(reset) %C(bold yellow)%d%C(reset)' \
    --branches --remotes --tags
  l = log --pretty=oneline -n 20 --graph --abbrev-commit
  put = push -u origin HEAD

  save = commit -m "SAVE"
  step-back = reset --soft HEAD^

  change = "!git switch $(git branch-select)"
  branches = "!f() { git for-each-ref --sort=-committerdate refs/heads/ --format='%(committerdate:relative)|%(refname:short)|%(contents:subject)' | awk -F'|' -v q=\"${1:-}\" 'tolower($2) ~ tolower(q)' | column -t -s '|'; }; f"
  branch-select = "!git for-each-ref --sort=-committerdate refs/heads/ --format='%(refname:short) %(committerdate:relative)' | fzf --height=20% --reverse --info=inline | awk '{print $1}'"
  branch-name = current-branch

  freshb = "!f() { git fetch && git checkout -b $1 origin/main; }; f"

  current-branch = "!git rev-parse --abbrev-ref HEAD"
  default-branch = "!git symbolic-ref refs/remotes/origin/HEAD | cut -f4 -d/"

  sync = "!git pull origin $(git default-branch) --rebase"
  update = "!git pull origin $(git rev-parse --abbrev-ref HEAD) --rebase"
  rb = "!f() { git fetch && DEFAULT=$(git default-branch); DEFAULT=${DEFAULT:-main}; git rebase origin/$DEFAULT; }; f"

    # Finish the current worktree or branch (workmux-aware)
  done = "!f() {\n  wt=\"$(git rev-parse --show-toplevel)\" || exit 1\n  gitdir=\"$(git -C \"$wt\" rev-parse --path-format=absolute --git-dir 2>/dev/null || git -C \"$wt\" rev-parse --git-dir)\"\n  common=\"$(git -C \"$wt\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || git -C \"$wt\" rev-parse --git-common-dir)\"\n\n  if [ \"$gitdir\" != \"$common\" ]; then\n    if command -v workmux >/dev/null 2>&1; then\n      workmux rm \"$@\"\n    else\n      branch=\"$(git -C \"$wt\" branch --show-current)\"\n      echo \"Removing worktree: $wt\"\n      cd / || exit 1\n      git --git-dir=\"$common\" worktree remove \"$@\" \"$wt\" &&\n        git --git-dir=\"$common\" worktree prune &&\n        if [ -n \"$branch\" ]; then git --git-dir=\"$common\" branch -D \"$branch\"; fi\n    fi\n    return\n  fi\n\n  branch=\"$(git -C \"$wt\" branch --show-current)\"\n  if [ -z \"$branch\" ]; then\n    echo \"Refusing: worktree is in detached HEAD state\"\n    exit 1\n  fi\n\n  default=\"$(git -C \"$wt\" default-branch 2>/dev/null || git -C \"$wt\" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed \"s#^origin/##\")\"\n  default=\"${default:-main}\"\n\n  if [ \"$branch\" = \"$default\" ]; then\n    echo \"Refusing to delete default branch: $branch\"\n    exit 1\n  fi\n\n  echo \"Switching to $default and deleting branch: $branch\"\n  git -C \"$wt\" switch \"$default\" &&\n    git -C \"$wt\" branch -D \"$branch\"\n}; f"
  destroy = "!BRANCH=$(git current-branch); f() { git checkout $(git default-branch) && git branch -D $BRANCH && git push origin --delete $BRANCH; }; f"

  aliases = config --get-regexp alias

  change-stats = "!git diff origin...HEAD --numstat | awk '{ added += $1; removed += $2 } END { print \"+\" added \" -\" removed }'"

    # Find branches containing commit
  fb = "!f() { git branch -a --contains $1; }; f"

    # Find tags containing commit
  ft = "!f() { git describe --always --contains $1; }; f"

    # Find commits by commit message
  fm = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; f"

    # Interactive cleanup of local branches and worktrees
  scrub = "!f() {\n  default=\"$(git default-branch 2>/dev/null || echo main)\"\n  default=\"${default:-main}\"\n  base=\"origin/$default\"\n  git rev-parse --verify \"$base\" >/dev/null 2>&1 || base=\"$default\"\n  merged=\"$(git for-each-ref --merged=\"$base\" refs/heads/ --format=\"%(refname:short)\" | paste -sd \",\" -)\"\n\n  selected=\"$(git for-each-ref --sort=-committerdate refs/heads/ --format=\"%(refname:short)|%(committerdate:relative)|%(upstream:track)|%(worktreepath)|%(contents:subject)\" |\n    awk -F\"|\" -v merged=\"$merged\" -v def=\"$default\" '\n      BEGIN { n = split(merged, m, \",\"); for (i = 1; i <= n; i++) if (m[i] != \"\") is_merged[m[i]] = 1 }\n      {\n        br = $1; age = $2; track = $3; wt = $4; subj = $5\n        if (br == def) next\n        state = (is_merged[br] ? \"[merged]\" : (track == \"[gone]\" ? \"[gone]\" : \"[unmerged]\"))\n        wt_col = \"-\"\n        if (wt != \"\") {\n          wt_name = wt\n          sub(/^.*\\/(\\.worktrees|worktrees\\/[^\\/]+)\\//, \"\", wt_name)\n          if (wt_name == wt) sub(/^.*\\//, \"\", wt_name)\n          wt_col = \"[wt:\" wt_name \"]\"\n        }\n        printf \"%s|%s|%s|%s|%s\\n\", br, age, state, wt_col, subj\n      }' |\n    column -t -s \"|\" |\n    fzf --multi --query \"${1:-}\" \\\n      --header \"Select branches/worktrees to DELETE (TAB to multi-select)\" \\\n      --preview 'wt=$(git for-each-ref --format=\"%(worktreepath)\" \"refs/heads/{1}\"); if [ -n \"$wt\" ] && [ -d \"$wt\" ]; then echo \"=== Worktree: $wt ===\"; git -C \"$wt\" status -sb; echo \"\"; fi; git log --color=always --oneline --graph --max-count=15 {1}')\"\n\n  [ -z \"$selected\" ] && return 0\n\n  echo \"$selected\" | awk '{print $1}' | while read -r br; do\n    [ -z \"$br\" ] && continue\n    wt=\"$(git for-each-ref --format=\"%(worktreepath)\" \"refs/heads/$br\")\"\n    if [ -n \"$wt\" ]; then\n      if command -v workmux >/dev/null 2>&1; then\n        echo \"Removing worktree & branch via workmux: $br ($wt)\"\n        workmux rm -f \"$br\" || workmux rm -f \"$(basename \"$wt\")\"\n      else\n        echo \"Removing worktree $wt and branch $br\"\n        git worktree remove --force \"$wt\" && git branch -D \"$br\"\n      fi\n    else\n      git branch -D \"$br\"\n    fi\n  done\n}; f"

    # Interactive cleanup of remote branches on origin
  scrub-remote = "!f() {\n  default=\"$(git default-branch 2>/dev/null || echo main)\"\n  default=\"${default:-main}\"\n  git for-each-ref --sort=-committerdate refs/remotes/origin/ --format=\"%(refname:lstrip=3)|%(committerdate:relative)|%(authorname)|%(contents:subject)\" |\n    awk -F\"|\" -v def=\"$default\" '$1 != \"HEAD\" && $1 != def && $1 != \"\"' |\n    column -t -s \"|\" |\n    fzf --multi --query \"${1:-aj/}\" \\\n      --header \"Select REMOTE origin branches to DELETE (TAB to multi-select)\" \\\n      --preview 'git log --color=always --oneline --graph --max-count=15 origin/{1}' |\n    awk '{print $1}' |\n    xargs -r git push origin --delete\n}; f"

    # List contributors with number of commits.
  contributors = shortlog --summary --numbered --no-merges
  bug-files = "!git log -i -E --grep=\"fix|bug|broken\" --name-only --format='' | sort | uniq -c | sort -nr | head -20"
  commits-by-month = "!git log --format='%ad' --date=format:'%Y-%m' | sort | uniq -c"
  risky-commits = "!git log --oneline --since=\"1 year ago\" | grep -iE 'revert|hotfix|emergency|rollback'"
  top-files = "!git log --format=format: --name-only --since=\"1 year ago\" | sort | uniq -c | sort -nr | head -20"

    # Show the user email for the current repository.
  whoami = config user.email
  whatadded = log --diff-filter=A
	my-changes = "!f() { if [ \"$#\" -eq 0 ]; then echo \"usage: git my-changes <time, e.g. last week>\" >&2; return 2; fi; email=$(git config user.email); if [ -z \"$email\" ]; then echo \"git user.email is not configured\" >&2; return 2; fi; git log --all --author=\"<$email>\" --since=\"$*\" --oneline --decorate; }; f"

[include]
  path = ~/.gitoverrides
[checkout]
	workers = 8
